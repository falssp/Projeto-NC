    {"col": "AW","header": "MidiaAdName-Extra",       "type": "free",                           "level": "ad", "optional": true},
    {"col": "AX","header": "MidiaName-Extra",         "type": "free",                           "level": "ad", "optional": true},
    {"col": "AY","header": "Seconds",                 "type": "free",                           "level": "ad", "optional": true},
    {"col": "AZ","header": "📋 Objetivo-Short Ad",   "type": "cn_result","level": "ad"},
