    {"col": "BC","header": "✅ Status",               "type": "formula",                        "level": "fml"}
  ],
  "formulas": {
    "campaign": {
      "col": "R",
      "pattern": "C_D_B_E_sh(F)_sh(H)_sh(I)_J",
      "optional_pipes": ["K","L","M","N","O","P","Q"]
    },
    "adgroup": {
      "col": "AJ",
      "pattern": "S_T_U_V_W_X_Y_age(Z,AA)_AB_AC",
      "optional_pipes": ["AD","AE","AF","AG","AH","AI"]
    },
    "ad": {
      "col": "BB",
      "pattern": "AL_AM_sh(AN)_AP_AQ_AR_AS",
      "optional_underscores": ["AT","AU","AV"],
      "fs_vs_seconds": {"fs": "AO", "sec": "AY", "tag": "AZ"},
      "optional_pipes": ["AW","AX","AY","AZ","BA"]
    }
  },
  "_note": "DV360-TD tem dois CN codes (B=campaign, C=ad). pp(AY) é mantido explicitamente porque o cliente tem Seconds na base."
}
